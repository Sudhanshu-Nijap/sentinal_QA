# Server Port (default 5005)
PORT=5005

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sentinel?retryWrites=true&w=majority

# Groq LLM API Keys (Primary AI Engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_API_KEY=your_groq_chat_api_key_here
GROQ_QA_API_KEY=your_groq_qa_api_key_here

# Google APIs (Optional / Safe Browsing)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SB_API_KEY=your_google_safe_browsing_api_key_here

# Automation & Webhooks (Optional)
N8N_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook
